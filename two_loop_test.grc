- name: pkt_counter
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nPacket counter: counts every packet on SRS-4 Receiver csp_out.\n\
      Press \"Reset count\" to set the count back to 0.\n\"\"\"\nimport threading\n\
      import pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n    def\
      \ __init__(self, reset=0):\n        gr.basic_block.__init__(self, name=\"Packet\
      \ counter\", in_sig=None, out_sig=None)\n        self._reset = reset\n     \
      \   self._n = 0\n        self._lock = threading.Lock()\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.set_msg_handler(pmt.intern(\"in\"), self._handle)\n\n \
      \   # Called by GRC when the reset button changes; resets on the press\n   \
      \ @property\n    def reset(self):\n        return self._reset\n\n    @reset.setter\n\
      \    def reset(self, v):\n        if v and not self._reset:\n            with\
      \ self._lock:\n                self._n = 0\n        self._reset = v\n\n    def\
      \ _handle(self, msg):\n        with self._lock:\n            self._n += 1\n\n\
      \    def count(self):\n        with self._lock:\n            return self._n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    reset: pkt_reset
  states:
    _io_cache: ('Packet counter', 'blk', [('reset', '0')], [('in', 'message', 1)],
      [], '', ['reset'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 140.0]
    rotation: 0
    state: enabled
