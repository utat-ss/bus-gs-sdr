- name: low_pass_filter_0
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'sps = 1 samp_rate = bandwidth

      samp_rate / sps ~= bandwidth


      Bandwith has to do with "squareness" of wave and samp_rate/sps


      shaping is controlled by alpha


      min(BW) = sps


      BW = symbol_rate*(1+alpha)'
    cutoff_freq: samp_rate/sps/2*(1+alpha)*2.0
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_ccf
    width: samp_rate/sps/2*(1+alpha)*0.5
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1728, 280.0]
    rotation: 0
    state: bypassed
