- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    Repeating byte source:\n      0, 1, 2, ..., 255, 0, 1, ...\n\
      \    \"\"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n  \
      \          self,\n            name=\"Repeating 0-255 Byte Source\",\n      \
      \      in_sig=None,\n            out_sig=[np.uint8],\n        )\n\n        self.index\
      \ = 0\n\n    def work(self, input_items, output_items):\n        out = output_items[0]\n\
      \        n = len(out)\n\n        out[:] = (self.index + np.arange(n)) % 256\n\
      \        self.index = (self.index + n) % 256\n\n        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Repeating 0-255 Byte Source', 'blk', [], [], [('0', 'byte', 1)],
      '\nRepeating byte source:\n  0, 1, 2, ..., 255, 0, 1, ...\n', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 336.0]
    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nfrom collections import\
      \ deque\n\n\nclass blk(gr.sync_block):\n    \"\"\"\n    Real-time BER calculator\
      \ for repeated byte pilot:\n\n        0, 1, 2, ..., 255, 0, 1, 2, ...\n\n  \
      \  BUT input is an unpacked bit stream:\n\n        in0: uint8 stream, values\
      \ 0 or 1\n             one bit per byte, i.e. GNU Radio \"purple\" byte stream\n\
      \n    Output:\n        out0: float32 BER estimate\n\n    This block does NOT\
      \ need a TX input.\n    It regenerates the expected 0..255 pilot internally,\
      \ unpacks it into bits,\n    finds the bit-level phase offset, then compares\
      \ bit-by-bit.\n\n    bitorder:\n        \"big\"    = MSB first, matches np.unpackbits(...,\
      \ bitorder=\"big\")\n        \"little\" = LSB first\n        \"auto\"   = try\
      \ both during sync and use the better one\n    \"\"\"\n\n    def __init__(\n\
      \        self,\n        sync_buffer_size=4096,\n        report_every=8000,\n\
      \        window_size=80000,\n        realign_interval=200000,\n        periodic_realign=True,\n\
      \        bitorder=\"auto\",\n    ):\n        gr.sync_block.__init__(\n     \
      \       self,\n            name=\"Pilot BER Calculator Bits 0-255\",\n     \
      \       in_sig=[np.uint8],\n            out_sig=[np.float32],\n        )\n\n\
      \        self.sync_buffer_size = int(sync_buffer_size)\n        self.report_every\
      \ = int(report_every)\n        self.window_size = int(window_size)\n       \
      \ self.realign_interval = int(realign_interval)\n        self.periodic_realign\
      \ = bool(periodic_realign)\n        self.bitorder = str(bitorder)\n\n      \
      \  if self.sync_buffer_size <= 0:\n            raise ValueError(\"sync_buffer_size\
      \ must be positive\")\n\n        if self.bitorder not in [\"big\", \"little\"\
      , \"auto\"]:\n            raise ValueError('bitorder must be \"big\", \"little\"\
      , or \"auto\"')\n\n        # Byte pilot: 0, 1, 2, ..., 255\n        self.byte_pilot\
      \ = np.arange(256, dtype=np.uint8)\n\n        # Bit pilots. Each has length\
      \ 256 * 8 = 2048 bits.\n        self.bit_pilots = {\n            \"big\": np.unpackbits(self.byte_pilot,\
      \ bitorder=\"big\").astype(np.uint8),\n            \"little\": np.unpackbits(self.byte_pilot,\
      \ bitorder=\"little\").astype(np.uint8),\n        }\n\n        self.active_bitorder\
      \ = None\n        self.pilot_bits = None\n        self.pilot_len_bits = None\n\
      \n        self.rx_buffer = np.array([], dtype=np.uint8)\n\n        self.synced\
      \ = False\n        self.pilot_bit_index = 0\n        self.last_ber = 0.0\n\n\
      \        self.bits_since_report = 0\n        self.bits_since_realign = 0\n\n\
      \        self.window = deque()\n        self.window_error_sum = 0\n        self.window_bit_sum\
      \ = 0\n\n    def make_expected_bits(self, start_index, n):\n        positions\
      \ = (start_index + np.arange(n)) % self.pilot_len_bits\n        return self.pilot_bits[positions]\n\
      \n    def find_pilot_offset_for_order(self, rx, order):\n        \"\"\"\n  \
      \      Try all bit offsets inside one full pilot period.\n\n        Returns:\n\
      \            best_offset, best_errors\n        \"\"\"\n        pilot = self.bit_pilots[order]\n\
      \        period = len(pilot)\n\n        best_offset = 0\n        best_errors\
      \ = None\n\n        # Try all 2048 possible bit-level offsets\n        for offset\
      \ in range(period):\n            positions = (offset + np.arange(len(rx))) %\
      \ period\n            expected = pilot[positions]\n\n            errors = int(np.sum(rx\
      \ != expected))\n\n            if best_errors is None or errors < best_errors:\n\
      \                best_errors = errors\n                best_offset = offset\n\
      \n        return best_offset, best_errors\n\n    def find_pilot_offset(self,\
      \ rx):\n        \"\"\"\n        Finds:\n          1. bit order, if bitorder=\"\
      auto\"\n          2. bit offset within the 2048-bit repeated pilot\n       \
      \ \"\"\"\n        rx = rx & 0x01\n\n        if self.bitorder == \"auto\":\n\
      \            orders_to_try = [\"big\", \"little\"]\n        else:\n        \
      \    orders_to_try = [self.bitorder]\n\n        best_order = None\n        best_offset\
      \ = None\n        best_errors = None\n\n        for order in orders_to_try:\n\
      \            offset, errors = self.find_pilot_offset_for_order(rx, order)\n\n\
      \            if best_errors is None or errors < best_errors:\n             \
      \   best_errors = errors\n                best_offset = offset\n           \
      \     best_order = order\n\n        self.active_bitorder = best_order\n    \
      \    self.pilot_bits = self.bit_pilots[best_order]\n        self.pilot_len_bits\
      \ = len(self.pilot_bits)\n\n        sync_ber = best_errors / len(rx)\n\n   \
      \     print(\n            f\"[Pilot BER Bits] Sync search: \"\n            f\"\
      bitorder={best_order}, \"\n            f\"best bit offset={best_offset}, \"\n\
      \            f\"sync BER={sync_ber:.6f}\"\n        )\n\n        return best_offset\n\
      \n    def add_window_result(self, errors, bits):\n        self.window.append((int(errors),\
      \ int(bits)))\n        self.window_error_sum += int(errors)\n        self.window_bit_sum\
      \ += int(bits)\n\n        while self.window_bit_sum > self.window_size and len(self.window)\
      \ > 1:\n            old_errors, old_bits = self.window.popleft()\n         \
      \   self.window_error_sum -= old_errors\n            self.window_bit_sum -=\
      \ old_bits\n\n    def current_window_ber(self):\n        if self.window_bit_sum\
      \ == 0:\n            return 0.0\n        return self.window_error_sum / self.window_bit_sum\n\
      \n    def process_rx_bits(self, rx_bits):\n        n = len(rx_bits)\n      \
      \  if n == 0:\n            return\n\n        rx_bits = rx_bits & 0x01\n    \
      \    expected = self.make_expected_bits(self.pilot_bit_index, n)\n\n       \
      \ errors = int(np.sum(rx_bits != expected))\n        bits = n\n\n        self.add_window_result(errors,\
      \ bits)\n\n        self.pilot_bit_index = (self.pilot_bit_index + n) % self.pilot_len_bits\n\
      \n        self.bits_since_report += bits\n        self.bits_since_realign +=\
      \ bits\n\n        if self.bits_since_report >= self.report_every:\n        \
      \    self.last_ber = self.current_window_ber()\n            print(\n       \
      \         f\"[Pilot BER Bits] BER = {self.last_ber:.6f}, \"\n              \
      \  f\"bitorder={self.active_bitorder}, \"\n                f\"pilot_bit_index={self.pilot_bit_index},\
      \ \"\n                f\"window={self.window_error_sum}/{self.window_bit_sum}\
      \ bits\"\n            )\n            self.bits_since_report = 0\n\n    def reset_sync(self):\n\
      \        self.synced = False\n        self.rx_buffer = np.array([], dtype=np.uint8)\n\
      \        self.bits_since_realign = 0\n        print(\"[Pilot BER Bits] Re-aligning...\"\
      )\n\n    def work(self, input_items, output_items):\n        rx_in = np.asarray(input_items[0],\
      \ dtype=np.uint8)\n        out = output_items[0]\n        n = len(rx_in)\n\n\
      \        # Sanity warning, sampled lightly\n        if n > 0:\n            sample\
      \ = rx_in[:min(n, 1024)]\n            unique = np.unique(sample)\n         \
      \   if not np.all((unique == 0) | (unique == 1)):\n                print(\n\
      \                    \"[Pilot BER Bits WARNING] Input is not purely 0/1. \"\n\
      \                    f\"Unique sample values: {unique[:20]}\"\n            \
      \    )\n\n        if not self.synced:\n            self.rx_buffer = np.concatenate((self.rx_buffer,\
      \ (rx_in & 0x01).copy()))\n\n            if len(self.rx_buffer) >= self.sync_buffer_size:\n\
      \                sync_rx = self.rx_buffer[:self.sync_buffer_size]\n\n      \
      \          offset = self.find_pilot_offset(sync_rx)\n\n                self.synced\
      \ = True\n                self.pilot_bit_index = offset\n\n                print(\n\
      \                    f\"[Pilot BER Bits] Initial lock: \"\n                \
      \    f\"rx_buffer[0] aligned to pilot bit {offset} \"\n                    f\"\
      using bitorder={self.active_bitorder}\"\n                )\n\n             \
      \   # Process all buffered samples, including sync buffer\n                buffered\
      \ = self.rx_buffer\n                self.rx_buffer = np.array([], dtype=np.uint8)\n\
      \                self.process_rx_bits(buffered)\n\n        else:\n         \
      \   self.process_rx_bits(rx_in)\n\n            if self.periodic_realign and\
      \ self.bits_since_realign >= self.realign_interval:\n                self.reset_sync()\n\
      \n        out[:] = self.last_ber\n        return n\n"
    affinity: ''
    alias: ''
    bitorder: '"auto"'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    periodic_realign: 'True'
    realign_interval: '200000'
    report_every: 8000*2
    sync_buffer_size: '4096'
    window_size: '80000'
  states:
    _io_cache: '(''Pilot BER Calculator Bits 0-255'', ''blk'', [(''sync_buffer_size'',
      ''4096''), (''report_every'', ''8000''), (''window_size'', ''80000''), (''realign_interval'',
      ''200000''), (''periodic_realign'', ''True''), (''bitorder'', "''auto''")],
      [(''0'', ''byte'', 1)], [(''0'', ''float'', 1)], ''\nReal-time BER calculator
      for repeated byte pilot:\n\n    0, 1, 2, ..., 255, 0, 1, 2, ...\n\nBUT input
      is an unpacked bit stream:\n\n    in0: uint8 stream, values 0 or 1\n         one
      bit per byte, i.e. GNU Radio "purple" byte stream\n\nOutput:\n    out0: float32
      BER estimate\n\nThis block does NOT need a TX input.\nIt regenerates the expected
      0..255 pilot internally, unpacks it into bits,\nfinds the bit-level phase offset,
      then compares bit-by-bit.\n\nbitorder:\n    "big"    = MSB first, matches np.unpackbits(...,
      bitorder="big")\n    "little" = LSB first\n    "auto"   = try both during sync
      and use the better one\n'', [''bitorder'', ''periodic_realign'', ''realign_interval'',
      ''report_every'', ''sync_buffer_size'', ''window_size''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1072, 1048.0]
    rotation: 0
    state: disabled
